<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorFondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <!-- Encabezado de Titulo -->
        <TextView
            android:id="@+id/tvTituloSensores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/info_sensor_titulo"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold"
            android:textColor="@color/textoPrimario"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- Encabezado de estado general -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/colorSurface"
            app:strokeWidth="@dimen/card_stroke_width"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/vSemaforo"
                    android:layout_width="@dimen/tamano_semaforo"
                    android:layout_height="@dimen/tamano_semaforo"
                    android:background="@drawable/bg_semaforo"
                    android:layout_marginEnd="@dimen/margin_medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_conforme"
                        android:textSize="@dimen/text_size_title"
                        android:textStyle="bold"
                        android:textColor="@color/estadoConforme" />

                    <TextView
                        android:id="@+id/tvFuente"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvMarcaTiempo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/text_size_small"
                        android:textColor="@color/textoSecundario" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de Lecturas de Sensores -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/colorSurface"
            app:strokeWidth="@dimen/card_stroke_width"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_lecturas"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    android:textColor="@color/textoPrimario"
                    android:layout_marginBottom="@dimen/margin_small" />

                <!-- Viales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_viales"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvValViales"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/value_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Refrigerador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_refrig"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvValRefrig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/value_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Exterior / Ambiente -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_exterior"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvValExterior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/value_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Humedad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_humedad"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvValHumedad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/value_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de Actuadores -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActuadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/colorSurface"
            app:strokeWidth="@dimen/card_stroke_width"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_actuadores"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    android:textColor="@color/textoPrimario"
                    android:layout_marginBottom="@dimen/margin_small" />

                <!-- Calefactor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_calefactor"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvCalefactor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_apagado"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Ventilador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_ventilador"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvVentilador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_apagado"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Cerradura -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_cerradura"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvCerradura"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_bloqueada"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Tapa / Puerta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_tapa"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvTapa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_cerrada"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bloque de Acumulados -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAcumulados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius"
            app:cardElevation="@dimen/card_elevation"
            app:cardUseCompatPadding="true"
            app:strokeColor="@color/colorSurface"
            app:strokeWidth="@dimen/card_stroke_width"
            android:layout_marginBottom="@dimen/margin_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_acumulados"
                    android:textSize="@dimen/text_size_large"
                    android:textStyle="bold"
                    android:textColor="@color/textoPrimario"
                    android:layout_marginBottom="@dimen/margin_small" />

                <!-- Minutos fuera de rango -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_min_fuera"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvMinFuera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:background="@color/colorSurface" />

                <!-- Aperturas registradas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/padding_xsmall"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_aperturas"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/textoSecundario" />

                    <TextView
                        android:id="@+id/tvAperturas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/valor_vacio"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold"
                        android:textColor="@color/textoPrimario" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Consulta del historial guardado en SQLite -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistorial"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_ver_historial"
            app:cornerRadius="@dimen/corner_radius_small"
            android:layout_marginTop="@dimen/margin_small" />

        <!-- Botón navegación -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnControl"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_sistema_control"
            app:cornerRadius="@dimen/corner_radius_small"
            android:layout_marginTop="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_medium" />

    </LinearLayout>

</ScrollView>
